@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Purchase Requisition',
                  typeNamePlural: 'Purchase Requisitions',
                  title: { type: #STANDARD, value: 'Title' },
                  description: { type: #STANDARD, value: 'PrID' } }
annotate view ZOA_C_PurchReqTP with
{
  @UI.facet: [ { label: 'General Information',
                 id: 'GeneralInfo',
                 purpose: #STANDARD,
                 position: 10,
                 type: #IDENTIFICATION_REFERENCE },
               { label: 'Items',
                 id: 'Items',
                 purpose: #STANDARD,
                 position: 20,
                 type: #LINEITEM_REFERENCE,
                 targetElement: '_Items' } ]

  @UI.hidden: true
  PrUUID;

  @EndUserText.label: 'Requisition No.'
  @UI.lineItem: [ { position: 10, importance: #HIGH },
                  { type: #FOR_ACTION, dataAction: 'submit',  label: 'Submit' },
                  { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
                  { type: #FOR_ACTION, dataAction: 'reject',  label: 'Reject' } ]
  @UI.identification: [ { position: 10 },
                        { type: #FOR_ACTION, dataAction: 'submit',  label: 'Submit' },
                        { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
                        { type: #FOR_ACTION, dataAction: 'reject',  label: 'Reject' } ]
  @UI.selectionField: [ { position: 10 } ]
  PrID;

  @EndUserText.label: 'Title'
  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 20 } ]
  Title;

  @EndUserText.label: 'Supplier'
  @UI.lineItem: [ { position: 30, importance: #HIGH } ]
  @UI.identification: [ { position: 30 } ]
  @UI.selectionField: [ { position: 20 } ]
  SupplierID;

  @UI.hidden: true
  SupplierName;

  @EndUserText.label: 'Delivery Date'
  @UI.lineItem: [ { position: 40 } ]
  @UI.identification: [ { position: 40 } ]
  DeliveryDate;

  @EndUserText.label: 'Total'
  @UI.lineItem: [ { position: 50, importance: #HIGH } ]
  @UI.identification: [ { position: 50 } ]
  TotalAmount;

  @UI.hidden: true
  CurrencyCode;

  @EndUserText.label: 'Status'
  @UI.textArrangement: #TEXT_ONLY
  @UI.lineItem: [ { position: 60, importance: #HIGH } ]
  @UI.identification: [ { position: 60 } ]
  @UI.selectionField: [ { position: 30 } ]
  Status;

  @UI.hidden: true
  StatusText;

  @EndUserText.label: 'Reject Reason'
  @UI.identification: [ { position: 70 } ]
  RejectReason;

  @EndUserText.label: 'Requested By'
  @UI.lineItem: [ { position: 70 } ]
  @UI.identification: [ { position: 80 } ]
  @UI.selectionField: [ { position: 40 } ]
  CreatedBy;

  @EndUserText.label: 'Created At'
  @UI.identification: [ { position: 90 } ]
  CreatedAt;

  @UI.hidden: true
  LocalLastChangedBy;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}