managed implementation in class ZBP_OA_R_PURCHREQTP unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZOA_R_PurchReqTP alias PurchReq
persistent table ZOA_PR_HEAD
extensible
draft table ZOA_PR_HEAD_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   PrUUID,
   Status,
   TotalAmount,
   CurrencyCode,
   CreatedBy,
   CreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( numbering : managed )
   PrUUID;


  create;
  update;
  delete;

  association _Items { create; with draft; }

  determination setDefaults on modify { create; }

  field ( mandatory )
   Title,
   SupplierID,
   DeliveryDate;

  validation validateSupplier on save { create; field SupplierID; }
  validation validateDeliveryDate on save { create; field DeliveryDate; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateSupplier;
    validation validateDeliveryDate;
    validation PurchReqItem~validateItemValues;
  }

  mapping for ZOA_PR_HEAD corresponding extensible
  {
    PrUUID = PR_UUID;
    PrID = PR_ID;
    Title = TITLE;
    SupplierID = SUPPLIER_ID;
    DeliveryDate = DELIVERY_DATE;
    TotalAmount = TOTAL_AMOUNT;
    CurrencyCode = CURRENCY_CODE;
    Status = STATUS;
    RejectReason = REJECT_REASON;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedAt = LAST_CHANGED_AT;
  }

}

define behavior for ZOA_R_PurchReqItemTP alias PurchReqItem
persistent table zoa_pr_item
draft table zoa_pr_item_d
etag master LocalLastChangedAt
lock dependent by _PurchReq
authorization dependent by _PurchReq
{
  field ( readonly )
   ItemUUID,
   PrUUID,
   ItemNo,
   ItemAmount,
   CurrencyCode;

  field ( numbering : managed )
   ItemUUID;

  update;
  delete;

  association _PurchReq { with draft; }

  determination setItemDefaults on modify { create; }

  determination calcAmounts on modify { create; field Quantity, UnitPrice; }

  side effects
  {
    field Quantity affects field ItemAmount, field _PurchReq.TotalAmount;
    field UnitPrice affects field ItemAmount, field _PurchReq.TotalAmount;
  }

   field ( mandatory )
   Description,
   Quantity,
   Unit,
   UnitPrice;

  validation validateItemValues on save { create; field Quantity, Unit, UnitPrice; }

  mapping for zoa_pr_item
  {
    ItemUUID           = item_uuid;
    PrUUID             = pr_uuid;
    ItemNo             = item_no;
    Description        = description;
    Quantity           = quantity;
    Unit               = unit;
    UnitPrice          = unit_price;
    ItemAmount         = item_amount;
    CurrencyCode       = currency_code;
    LocalLastChangedAt = local_last_changed_at;
  }
}